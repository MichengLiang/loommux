set dotenv-load := false

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --all-targets --all-features -- -D warnings

test:
    cargo nextest run --all-features

coverage:
    cargo llvm-cov nextest --all-features --workspace --fail-under-lines 95 --fail-under-functions 99 --fail-under-regions 90 --fail-uncovered-functions 2
    cargo llvm-cov report --text --output-path target/coverage.txt
    if rg '^\s*[0-9]+\|\s*0\|.*\bfn\b' target/coverage.txt; then echo 'authored function coverage is incomplete' >&2; exit 1; fi

concurrency-20:
    # The repetition gate owns flake detection; the test itself stays a normal fast suite member.
    for run in `seq 1 20`; do cargo nextest run --all-features -E 'test(four_adapter_namespaces_run_eight_execution_workloads_concurrently) | test(concurrent_status_exchanges_remain_typed_and_ordered)' || exit 1; done

deny:
    cargo deny check

verify: fmt lint test coverage deny
    cargo build --locked
    cargo build --release --locked
    cargo package --locked --allow-dirty
