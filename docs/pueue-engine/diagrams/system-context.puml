@startuml
title Loommux Pueue 执行引擎系统上下文
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center

actor "MCP Client A" as clientA
actor "MCP Client B" as clientB

rectangle "loommux-pueue A\nPueueMCPAdapter A\nexecution 1..N" as adapterA
rectangle "loommux-pueue B\nPueueMCPAdapter B\nexecution 1..N" as adapterB
database "pueued instance\nshared task state and logs" as daemon
rectangle "Pueue task 41" as task41
rectangle "Pueue task 42" as task42
rectangle "Pueue task 43" as task43

clientA --> adapterA : stdio MCP
clientB --> adapterB : stdio MCP
adapterA --> daemon : pueue-lib typed protocol
adapterB --> daemon : pueue-lib typed protocol
daemon --> task41
daemon --> task42
daemon --> task43

note bottom of adapterA
  execution is adapter-local
  task ID is private backend identity
end note

note bottom of daemon
  daemon lifecycle is not owned
  by either adapter
end note
@enduml
